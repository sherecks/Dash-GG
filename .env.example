# Copie para .env e preencha com o token real (Hubspot → Settings → Private Apps).
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORT=3000

# Supabase → Connect → Connection string → "Session pooler" (URI).
# Troque [YOUR-PASSWORD] pela senha do banco. Mantenha ?sslmode=require no fim.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
