# Copie para .env e preencha com os valores reais.
PORT=3000

# PostgreSQL no Railway (template postgres-ssl).
# Local: use a URL PÚBLICA (Postgres → Variables → DATABASE_PUBLIC_URL), com ?sslmode=require.
# No deploy do Railway: no serviço do app, DATABASE_URL = ${{Postgres.DATABASE_URL}} (interna).
DATABASE_URL=postgresql://postgres:[SENHA]@xxxx.proxy.rlwy.net:PORTA/railway?sslmode=require
